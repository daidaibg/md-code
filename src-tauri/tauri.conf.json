{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MD Code",
  "version": "0.3.0",
  "identifier": "com.mdcode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:608",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Code",
        "width": 900,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/nsis-hooks.nsh",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEZGRkVCNEEyNzFBMkI2N0IKUldSN3RxSnhvclQrLzZITlBIWG9OZ0xuNHVSYkNRZFE0S1FneE9jMSt0dzFCTHd0T003aFVoSnEK",
      "endpoints": [
        "https://github.com/daidaibg/md-code/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
