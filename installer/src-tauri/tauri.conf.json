{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MD Code 安装程序",
  "version": "0.2.0",
  "identifier": "com.mdcode.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Code 安装程序",
        "width": 880,
        "height": 620,
        "minWidth": 880,
        "minHeight": 620,
        "maxWidth": 880,
        "maxHeight": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
